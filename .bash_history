# 1. Compile test1.s into a RISC-V ELF binary
riscv64-unknown-elf-gcc -march=rv32i -mabi=ilp32 -Os -Wall -Wextra -Wl,-Bstatic,-T,sections.lds,--strip-debug -ffreestanding -nostdlib -o test1.elf test1.s
# 2. Convert the ELF into Verilog Hex format and save as firmware.hex
riscv64-unknown-elf-objcopy -O verilog test1.elf firmware.hex
# 3. Run the PyVerilator simulation
python testbench.py
riscv64-unknown-elf-gcc -march=rv32i -mabi=ilp32 -Os -Wall -Wextra -Wl,-Bstatic,-T,sections.lds,--strip-debug -ffreestanding -nostdlib -o fib.elf fib.s && riscv64-unknown-elf-objcopy -O verilog fib.elf firmware.hex && python testbench.py
